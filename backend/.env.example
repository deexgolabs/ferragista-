# Copie este arquivo para .env e ajuste os valores antes de rodar em produção.
# Em desenvolvimento, os valores padrão do config.py já funcionam sem .env.

SECRET_KEY=troque-esta-chave-por-uma-aleatoria
JWT_SECRET_KEY=troque-esta-chave-tambem-por-uma-aleatoria

# SQLite local por padrão. Em produção (ex: PythonAnywhere), aponte para
# MySQL/PostgreSQL: mysql+pymysql://usuario:senha@host/banco
# DATABASE_URL=sqlite:///instance/ferragista.db

# URL pública do frontend — usada em links de e-mail (redefinição de senha etc.)
FRONTEND_URL=http://localhost:5500

# E-mail (opcional). Sem isso configurado, e-mails só aparecem no console.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=seu-email@gmail.com
# MAIL_PASSWORD=sua-senha-de-app
# MAIL_DEFAULT_SENDER=Ferragista+ <seu-email@gmail.com>

# Redis (opcional) — só necessário se o backend rodar com múltiplos
# processos/workers e for preciso compartilhar o rate limiting entre eles.
# REDIS_URL=redis://localhost:6379/0
